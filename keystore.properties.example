# Template for local release signing.
#
#   1. Copy this file to `keystore.properties` (same directory).
#   2. Fill in the real values.
#   3. `keystore.properties` is gitignored - keep it that way.
#
# Generate a keystore with:
#
#   keytool -genkeypair -v \
#     -keystore focusreturn-release.jks -storetype PKCS12 \
#     -alias focusreturn -keyalg RSA -keysize 4096 -sigalg SHA256withRSA \
#     -validity 10950
#
# Use forward slashes in the path, or escape backslashes as `\\`.

storeFile=/absolute/path/to/focusreturn-release.jks
storePassword=CHANGE_ME
keyAlias=focusreturn
keyPassword=CHANGE_ME
